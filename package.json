{
  "name": "skill-forge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-app.mjs dev",
    "build": "npm run build --workspace @skillforge/client",
    "lint": "oxlint",
    "preview": "node scripts/run-app.mjs preview",
    "db:migrate:postgres": "npm run db:migrate:postgres --workspace @skillforge/server --",
    "test": "node --test tests/*.test.mjs",
    "db:setup:postgres": "npm run db:setup:postgres --workspace @skillforge/server"
  },
  "devDependencies": {
    "oxlint": "^1.81.0"
  },
  "workspaces": [
    "client",
    "server"
  ]
}
