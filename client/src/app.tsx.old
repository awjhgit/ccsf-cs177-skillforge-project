
import { useMemo, useState } from "react";
import "./index.css";

type Employee = {
  id: number;
  name: string;
  title: string;
  department: string;
  skills: string[];
  description: string;
  years: number;
  certifications: string[];
  links: { label: string; url: string }[];
};

const employees: Employee[] = [
  {
    id: 1,
    name: "Thomas Neo Anderson",
    title: "Software Engineer",
    department: "Engineering",
    skills: ["Python", "Django", "REST APIs", "AWS"],
    description:
      "5+ years building web applications with Python and Django. Experienced in cloud deployment and API integrations.",
    years: 5,
    certifications: ["AWS Certified"],
    links: [
      { label: "LinkedIn", url: "https://www.linkedin.com/" },
      { label: "GitHub", url: "https://github.com/" },
    ],
  },
  {
    id: 2,
    name: "Carrie Trinity",
    title: "Data Engineer",
    department: "Engineering",
    skills: ["Python", "SQL", "Data Pipelines", "Snowflake"],
    description:
      "Specializes in data engineering with Python and SQL. Builds scalable data pipelines and ETL processes.",
    years: 3,
    certifications: ["Snowflake Certified"],
    links: [{ label: "LinkedIn", url: "https://www.linkedin.com/" }],
  },
  {
    id: 3,
    name: "Laurence Morpheus",
    title: "Machine Learning Engineer",
    department: "Engineering",
    skills: ["Python", "Machine Learning", "TensorFlow", "PyTorch"],
    description:
      "Experience in machine learning and deep learning. Builds and deploys ML models in production environments.",
    years: 4,
    certifications: ["TensorFlow Certified"],
    links: [{ label: "GitHub", url: "https://github.com/" }],
  },
  {
    id: 4,
    name: "Hugo Agent Smith",
    title: "Cloud Solutions Architect",
    department: "IT",
    skills: ["Python", "Kubernetes", "Docker", "AWS"],
    description:
      "Designs cloud solutions using AWS and Kubernetes, with a strong background in container orchestration.",
    years: 6,
    certifications: ["AWS Certified"],
    links: [{ label: "LinkedIn", url: "https://www.linkedin.com/" }],
  },
  {
    id: 5,
    name: "Monica Persephone",
    title: "Full Stack Developer",
    department: "Engineering",
    skills: ["Python", "React", "Node.js", "PostgreSQL"],
    description:
      "Full stack developer using Python and React to build scalable web applications and APIs.",
    years: 3,
    certifications: ["React Certified"],
    links: [{ label: "GitHub", url: "https://github.com/" }],
  },
  {
    id: 6,
    name: "Randall Keymaker",
    title: "DevOps Engineer",
    department: "IT",
    skills: ["Docker", "Kubernetes", "Linux", "CI/CD"],
    description:
      "Experienced in DevOps, infrastructure automation, Linux systems, and containerization.",
    years: 4,
    certifications: ["CKA Certified"],
    links: [{ label: "LinkedIn", url: "https://www.linkedin.com/" }],
  },
  {
    id: 7,
    name: "Daniel Agent Johnson",
    title: "Project Manager",
    department: "Product",
    skills: ["Agile", "Scrum", "Jira", "Project Management"],
    description:
      "Leads cross-functional projects, facilitates Agile ceremonies, and improves delivery processes.",
    years: 8,
    certifications: ["PMP"],
    links: [{ label: "LinkedIn", url: "https://www.linkedin.com/" }],
  },
  {
    id: 8,
    name: "Helmut Architect",
    title: "Security Engineer",
    department: "IT",
    skills: ["Cybersecurity", "Cloud Security", "Linux", "AWS"],
    description:
      "Works on cloud security, access controls, vulnerability management, and infrastructure protection.",
    years: 7,
    certifications: ["AWS Certified", "Security+"],
    links: [{ label: "LinkedIn", url: "https://www.linkedin.com/" }],
  },
];

type Filters = {
  departments: string[];
  experience: string;
  certifications: string[];
};

const emptyFilters: Filters = {
  departments: [],
  experience: "",
  certifications: [],
};

function App() {
  const [query, setQuery] = useState("");
  const [submittedQuery, setSubmittedQuery] = useState("");
  const [filters, setFilters] = useState<Filters>(emptyFilters);
  const [sortBy, setSortBy] = useState("relevance");
  const [selectedEmployee, setSelectedEmployee] =
    useState<Employee | null>(null);

  // Update one filter while preserving the others.
  function toggleFilter(
    category: "departments" | "certifications",
    value: string
  ) {
    setFilters((current) => {
      const values = current[category];
      const updated = values.includes(value)
        ? values.filter((item) => item !== value)
        : [...values, value];

      return { ...current, [category]: updated };
    });
  }

  function clearFilters() {
    setFilters(emptyFilters);
  }

  // Calculate a simple, explainable relevance score.
  function calculateScore(employee: Employee) {
    const term = submittedQuery.trim().toLowerCase();

    if (!term) return 0;

    const skills = employee.skills.map((s) => s.toLowerCase());
    const title = employee.title.toLowerCase();
    const description = employee.description.toLowerCase();

    let score = 0;

    if (skills.some((skill) => skill === term)) score += 100;
    else if (skills.some((skill) => skill.includes(term))) score += 70;

    if (title.includes(term)) score += 40;
    if (description.includes(term)) score += 20;

    // Experience is a tie-breaker, not proof of proficiency.
    return score + Math.min(employee.years, 10) * 0.1;
  }

  const results = useMemo(() => {
    const term = submittedQuery.trim().toLowerCase();

    const filtered = employees.filter((employee) => {
      const searchableText = [
        employee.name,
        employee.title,
        employee.department,
        employee.description,
        ...employee.skills,
        ...employee.certifications,
      ]
        .join(" ")
        .toLowerCase();

      const matchesQuery = !term || searchableText.includes(term);

      const matchesDepartment =
        filters.departments.length === 0 ||
        filters.departments.includes(employee.department);

      const matchesCertification =
        filters.certifications.length === 0 ||
        filters.certifications.every((cert) =>
          employee.certifications.includes(cert)
        );

      const matchesExperience =
        !filters.experience ||
        (filters.experience === "0-2" &&
          employee.years <= 2) ||
        (filters.experience === "3-5" &&
          employee.years >= 3 &&
          employee.years <= 5) ||
        (filters.experience === "6-10" &&
          employee.years >= 6 &&
          employee.years <= 10) ||
        (filters.experience === "10+" &&
          employee.years > 10);

      return (
        matchesQuery &&
        matchesDepartment &&
        matchesCertification &&
        matchesExperience
      );
    });

    return filtered.sort((a, b) => {
      if (sortBy === "experience") return b.years - a.years;
      if (sortBy === "alphabetical") return a.name.localeCompare(b.name);

      return calculateScore(b) - calculateScore(a);
    });
  }, [submittedQuery, filters, sortBy]);

  function search() {
    setSubmittedQuery(query);
  }

  function handleSearchKeyDown(
    event: React.KeyboardEvent<HTMLInputElement>
  ) {
    if (event.key === "Enter") search();
  }

  return (
    <div className="app-shell">
      <header className="topbar">
        <a className="brand" href="#" aria-label="Skill Forge home">
          <span className="brand-icon">✳</span>
          Skill Forge
        </a>

        <nav className="navigation" aria-label="Main navigation">
          <a href="#home">Home</a>
          <a className="active" href="#directory">Directory</a>
          <a href="#connections">My Connections</a>
          <a href="#rewards">Rewards</a>
          <a href="#analytics">Analytics</a>
        </nav>

        <div className="account">
          <span className="avatar initials">JS</span>
          <span>Jamie Smith</span>
        </div>
      </header>

      <main id="directory" className="page">
        <section className="page-heading">
          <p className="eyebrow">PEOPLE & SKILL Library</p>
          <h1>Skills Directory</h1>
          <p>
            Find colleagues with the right skills and experience
            to collaborate, learn, and grow.
          </p>
        </section>

        <section className="search-panel" aria-label="Employee search">
          <form
            className="search-form"
            onSubmit={(event) => {
              event.preventDefault();
              search();
            }}
          >
            <label className="search-input">
              <span aria-hidden="true">⌕</span>
              <input
                value={query}
                onChange={(event) => setQuery(event.target.value)}
                onKeyDown={handleSearchKeyDown}
                placeholder='Search skills or expertise (e.g., "Python", "cloud architecture")'
                aria-label="Search skills or expertise"
              />
            </label>

            <button className="primary-button" type="submit">
              Search
            </button>
          </form>

          <div className="search-meta">
            <p>
              Showing <strong>{results.length}</strong>{" "}
              {results.length === 1 ? "profile" : "profiles"}
              {submittedQuery && (
                <> for <strong>“{submittedQuery}”</strong></>
              )}
            </p>

            <label className="sort-control">
              <span>Sort by</span>
              <select
                value={sortBy}
                onChange={(event) => setSortBy(event.target.value)}
              >
                <option value="relevance">Relevance</option>
                <option value="experience">Years of experience</option>
                <option value="alphabetical">Name (A–Z)</option>
              </select>
            </label>
          </div>
        </section>

        <div className="directory-layout">
          <aside className="filters-panel">
            <div className="filter-heading">
              <h2>Filters</h2>
              <button className="text-button" onClick={clearFilters}>
                Clear all
              </button>
            </div>

            <fieldset className="filter-group">
              <legend>Department</legend>
              {["Engineering", "IT", "Product", "Sales", "Marketing"].map(
                (department) => (
                  <label className="filter-option" key={department}>
                    <input
                      type="checkbox"
                      checked={filters.departments.includes(department)}
                      onChange={() =>
                        toggleFilter("departments", department)
                      }
                    />
                    <span>{department}</span>
                  </label>
                )
              )}
            </fieldset>

            <fieldset className="filter-group">
              <legend>Experience</legend>
              {[
                ["0-2", "0–2 years"],
                ["3-5", "3–5 years"],
                ["6-10", "6–10 years"],
                ["10+", "10+ years"],
              ].map(([value, label]) => (
                <label className="filter-option" key={value}>
                  <input
                    type="radio"
                    name="experience"
                    checked={filters.experience === value}
                    onChange={() =>
                      setFilters((current) => ({
                        ...current,
                        experience: value,
                      }))
                    }
                  />
                  <span>{label}</span>
                </label>
              ))}
              <button
                className="text-button clear-experience"
                onClick={() =>
                  setFilters((current) => ({
                    ...current,
                    experience: "",
                  }))
                }
              >
                Clear experience
              </button>
            </fieldset>

            <fieldset className="filter-group">
              <legend>Certifications</legend>
              {[
                "AWS Certified",
                "Snowflake Certified",
                "TensorFlow Certified",
                "PMP",
                "CKA Certified",
                "Security+",
              ].map((certification) => (
                <label className="filter-option" key={certification}>
                  <input
                    type="checkbox"
                    checked={filters.certifications.includes(certification)}
                    onChange={() =>
                      toggleFilter("certifications", certification)
                    }
                  />
                  <span>{certification}</span>
                </label>
              ))}
            </fieldset>

            <p className="filter-note">
              Filters combine with your search to narrow the results.
            </p>
          </aside>

          <section className="results-area" aria-label="Search results">
            {results.length > 0 ? (
              <div className="profile-grid">
                {results.map((employee) => (
                  <article className="profile-card" key={employee.id}>
                    <div className="profile-card-header">
                      <div className="avatar">
                        {employee.name
                          .split(" ")
                          .map((part) => part[0])
                          .join("")}
                      </div>
                      <div className="identity">
                        <h3>{employee.name}</h3>
                        <p>{employee.title}</p>
                        <span className="department-tag">
                          {employee.department}
                        </span>
                      </div>
                    </div>

                    <div className="skill-tags">
                      {employee.skills.map((skill) => (
                        <span className="skill-tag" key={skill}>
                          {skill}
                        </span>
                      ))}
                    </div>

                    <p className="experience-description">
                      {employee.description}
                    </p>

                    <div className="profile-details">
                      <span>
                        <strong>{employee.years} yrs</strong> experience
                      </span>
                      {employee.certifications.length > 0 && (
                        <span
                          className="certification"
                          title={employee.certifications.join(", ")}
                        >
                          ✧ {employee.certifications[0]}
                        </span>
                      )}
                    </div>

                    <div className="card-footer">
                      <div className="external-links">
                        {employee.links.map((link) => (
                          <a
                            href={link.url}
                            key={link.label}
                            target="_blank"
                            rel="noreferrer"
                            aria-label={`${employee.name}: ${link.label}`}
                            title={link.label}
                          >
                            {link.label}
                          </a>
                        ))}
                      </div>

                      <button
                        className="secondary-button"
                        onClick={() => setSelectedEmployee(employee)}
                      >
                        View Profile
                      </button>
                    </div>
                  </article>
                ))}
              </div>
            ) : (
              <div className="empty-state">
                <h2>No matching profiles found</h2>
                <p>
                  Try another skill or remove some filters to
                  see more colleagues.
                </p>
                <button
                  className="secondary-button"
                  onClick={() => {
                    setQuery("");
                    setSubmittedQuery("");
                    clearFilters();
                  }}
                >
                  Clear search and filters
                </button>
              </div>
            )}
          </section>
        </div>
      </main>

      {selectedEmployee && (
        <div
          className="modal-backdrop"
          onMouseDown={(event) => {
            if (event.target === event.currentTarget) {
              setSelectedEmployee(null);
            }
          }}
        >
          <section
            className="profile-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="modal-title"
          >
            <button
              className="modal-close"
              onClick={() => setSelectedEmployee(null)}
              aria-label="Close profile"
            >
              ×
            </button>

            <div className="modal-profile-header">
              <div className="avatar large">
                {selectedEmployee.name
                  .split(" ")
                  .map((part) => part[0])
                  .join("")}
              </div>
              <div>
                <h2 id="modal-title">{selectedEmployee.name}</h2>
                <p>{selectedEmployee.title}</p>
                <span className="department-tag">
                  {selectedEmployee.department}
                </span>
              </div>
            </div>

            <h3>Skills and expertise</h3>
            <div className="skill-tags">
              {selectedEmployee.skills.map((skill) => (
                <span className="skill-tag" key={skill}>
                  {skill}
                </span>
              ))}
            </div>

            <h3>Experience</h3>
            <p>{selectedEmployee.description}</p>
            <p>
              <strong>{selectedEmployee.years} years</strong> of
              reported experience.
            </p>

            <h3>Certifications</h3>
            <p>
              {selectedEmployee.certifications.join(", ") ||
                "No certifications listed."}
            </p>

            <h3>External profiles</h3>
            <div className="modal-links">
              {selectedEmployee.links.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noreferrer"
                  key={link.label}
                >
                  {link.label} ↗
                </a>
              ))}
            </div>

            <button
              className="primary-button modal-action"
              onClick={() =>
                window.alert(
                  "Connection requests will be implemented in the next phase."
                )
              }
            >
              Request Connection
            </button>
          </section>
        </div>
      )}

      <footer className="page-footer">
        Skill Forge · Internal Skills Discovery Prototype
      </footer>
    </div>
  );
}

export default App;
